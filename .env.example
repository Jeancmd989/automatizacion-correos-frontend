# ─────────────────────────────────────────────────────────────────────
# Plantilla de configuracion. Copiar a .env.local y completar.
#
# Las variables SIN el prefijo NEXT_PUBLIC_ viven solo en el servidor.
# Cualquier variable con ese prefijo acaba en el bundle que descarga el
# navegador: no poner ahi nada que no pueda ser publico.
# ─────────────────────────────────────────────────────────────────────

# URL interna del backend. Solo la usa el BFF; el navegador nunca la ve.
API_URL=http://localhost:8000

# Origen publico de esta aplicacion, para construir el redirect_uri.
APP_URL=http://localhost:3000

# ── Identidad (OIDC) ─────────────────────────────────────────────────
# El intercambio de codigo ocurre en el servidor: el client_secret nunca
# llega al navegador y el access token tampoco.
OIDC_ISSUER=https://tu-tenant.us.auth0.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=https://api.tu-dominio.com/automatizacion-correos

# Clave de firma de la cookie de sesion, 32 bytes como minimo.
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ── Publico ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Automatizacion de Correos

# ── Generacion del cliente de API (opcional) ─────────────────────────
# Por defecto se lee el openapi.json versionado en el repo del backend.
# Apuntar a un backend local para trabajar contra cambios sin publicar.
# OPENAPI_URL=http://localhost:8000/openapi.json
